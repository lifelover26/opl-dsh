{
  "name": "@one-person-lab/dsh-opl",
  "version": "0.2.59",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "OPL enhancements and one-click installation for official DeepSeek Harness Desktop",
  "scripts": {
    "build": "node build.mjs",
    "build:bridge": "node scripts/build-native-bridge.mjs",
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json && npm run typecheck --workspace dsh-superagent",
    "test": "vitest run && node --test --test-concurrency=1 tests/*.test.mjs && npm test --workspace dsh-superagent",
    "package": "npm run build && node package.mjs",
    "release:manifest": "node scripts/create-release-manifest.mjs",
    "format": "prettier --write src tests scripts installer/*.mjs build.mjs",
    "format:check": "prettier --check src tests scripts installer/*.mjs build.mjs",
    "generate:rpc": "node scripts/generate-rpc.mjs",
    "check:rpc": "node scripts/generate-rpc.mjs --check",
    "check:boundaries": "node scripts/check-module-boundaries.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "@deepseek-ai/cordis": "4.1.0",
