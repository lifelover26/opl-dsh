+/// Decode shell text across producer chunks without losing split UTF-8 or legacy
+/// code-page characters. UTF-8 remains the default. An invalid UTF-8 stream is
+/// sampled through a newline (or 8 KiB), then decoded with one persistent decoder
+/// until that line ends. A new line may come from a differently encoded child.
+/// Automatic detection is best effort; mixed encodings within a line are ambiguous.
+#[derive(Default)]
+pub struct ShellOutputDecoder {
+    pending: Vec<u8>,
+    legacy: bool,
+    decoder: Option<encoding_rs::Decoder>,
+}
+
+impl ShellOutputDecoder {
+    pub fn push(&mut self, bytes: &[u8]) -> Vec<u8> {
+        let mut output = String::new();
+        // Keep detection memory bounded even for a very large producer chunk.
+        for chunk in bytes
+            .split_inclusive(|byte| *byte == b'\n')
+            .flat_map(|line| line.chunks(8192))
+        {
+            output.push_str(&self.push_chunk(chunk));
+            if chunk.last() == Some(&b'\n') {
+                if self.decoder.is_some() {
+                    output.push_str(&self.decode(&[], true));
+                }
+                self.pending.clear();
+                self.legacy = false;
+                self.decoder = None;
+            }
+        }
+        output.into_bytes()
+    }
+
+    fn push_chunk(&mut self, chunk: &[u8]) -> String {
+        let mut output = String::new();
+        if self.decoder.is_some() {
+            output.push_str(&self.decode(chunk, false));
+            return output;
+        }
+        self.pending.extend_from_slice(chunk);
+        if !self.legacy {
+            match std::str::from_utf8(&self.pending) {
+                Ok(text) => {
+                    output.push_str(text);
+                    self.pending.clear();
+                    return output;
+                }
+                Err(error) if error.error_len().is_none() => {
+                    let prefix = error.valid_up_to();
+                    // The prefix is verified UTF-8 by Utf8Error::valid_up_to.
+                    output.push_str(&String::from_utf8_lossy(&self.pending[..prefix]));
+                    self.pending.drain(..prefix);
+                    return output;
+                }
+                Err(_) => self.legacy = true,
+            }
+        }
+        if self.pending.contains(&b'\n') || self.pending.len() >= 8192 {
+            self.decoder = Some(detect_encoding(&self.pending).new_decoder_without_bom_handling());
+            let pending = std::mem::take(&mut self.pending);
+            output.push_str(&self.decode(&pending, false));
+        }
+        output
+    }
+
+    pub fn finish(mut self) -> Vec<u8> {
+        let pending = std::mem::take(&mut self.pending);
+        if self.decoder.is_none() {
+            if !self.legacy {
+                return String::from_utf8_lossy(&pending).into_owned().into_bytes();
+            }
+            return bytes_to_string_smart(&pending).into_bytes();
+        }
+        self.decode(&pending, true).into_bytes()
+    }
+
+    fn decode(&mut self, bytes: &[u8], last: bool) -> String {
+        let Some(decoder) = self.decoder.as_mut() else {
+            return String::new();
+        };
+        let mut text = String::with_capacity(bytes.len().saturating_mul(3).saturating_add(16));
+        let mut offset = 0;
+        loop {
+            let (result, read, _) = decoder.decode_to_string(&bytes[offset..], &mut text, last);
+            offset += read;
+            match result {
+                encoding_rs::CoderResult::InputEmpty => break,
+                encoding_rs::CoderResult::OutputFull => text.reserve(8192),
+            }
+        }
+        text
+    }
 }
 
