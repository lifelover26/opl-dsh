+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn every_byte_boundary_preserves_valid_unicode() {
+        let value = "中文🚀🧪𠀀�".as_bytes();
+        for cut in 0..=value.len() {
+            let mut p = ByteProbe::default();
+            p.push(&value[..cut]);
+            p.push(&value[cut..]);
+            assert_eq!(
+                (p.invalid, p.pending, p.replacements, p.bytes),
+                (0, 0, 1, value.len() as u64)
+            );
+        }
+        let mut p = ByteProbe::default();
+        for b in value {
+            p.push(&[*b]);
+        }
+        assert_eq!((p.invalid, p.pending, p.replacements), (0, 0, 1));
+    }
+    #[test]
+    fn invalid_overlong_surrogates_and_truncated_sequences_are_distinguished() {
+        for input in [
+            &b"\xff"[..],
+            &b"\xe0\x80\x80"[..],
+            &b"\xed\xa0\x80"[..],
+            &b"\xf4\x90\x80\x80"[..],
+            &b"\xe4x"[..],
+        ] {
+            let mut p = ByteProbe::default();
+            p.push(input);
+            assert!(p.invalid > 0);
+            assert_eq!(p.replacements, 0);
+        }
+        let mut p = ByteProbe::default();
+        p.push(b"\xe4\xb8");
+        assert_eq!((p.invalid, p.pending), (0, 1));
+    }
+    #[test]
+    fn escaped_replacement_is_not_raw_unicode() {
+        let mut p = ByteProbe::default();
+        p.push(br#""\ufffd""#);
+        assert_eq!(p.replacements, 0);
+        let parsed: String = serde_json::from_slice(br#""\ufffd""#).unwrap();
+        assert_eq!(parsed, "�");
+    }
+}
