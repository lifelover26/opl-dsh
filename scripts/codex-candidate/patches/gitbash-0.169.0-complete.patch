+/// Constant-memory UTF-8 validator across arbitrary transport chunk boundaries.
+/// Counts literal U+FFFD; JSON escapes are counted after JSON parsing instead.
+#[derive(Default, Debug)]
+pub struct ByteProbe {
+    pub bytes: u64,
+    pub replacements: u64,
+    pub invalid: u64,
+    pub pending: u8,
+    scalar: u32,
+    minimum: u32,
+}
+
+impl ByteProbe {
+    pub fn push(&mut self, bytes: &[u8]) {
+        self.bytes += bytes.len() as u64;
+        for &b in bytes {
+            if self.pending != 0 {
+                if b & 0xc0 == 0x80 {
+                    self.scalar = (self.scalar << 6) | u32::from(b & 0x3f);
+                    self.pending -= 1;
+                    if self.pending == 0 {
+                        if self.scalar < self.minimum
+                            || self.scalar > 0x10ffff
+                            || (0xd800..=0xdfff).contains(&self.scalar)
+                        {
+                            self.invalid += 1;
+                        } else if self.scalar == 0xfffd {
+                            self.replacements += 1;
+                        }
+                    }
+                    continue;
+                }
+                self.invalid += 1;
+                self.pending = 0;
+            }
+            match b {
+                0..=0x7f => {}
+                0xc2..=0xdf => {
+                    self.pending = 1;
+                    self.scalar = u32::from(b & 0x1f);
+                    self.minimum = 0x80;
+                }
+                0xe0..=0xef => {
+                    self.pending = 2;
+                    self.scalar = u32::from(b & 0x0f);
+                    self.minimum = 0x800;
+                }
+                0xf0..=0xf4 => {
+                    self.pending = 3;
+                    self.scalar = u32::from(b & 7);
+                    self.minimum = 0x10000;
+                }
+                _ => self.invalid += 1,
+            }
+        }
+    }
+}
