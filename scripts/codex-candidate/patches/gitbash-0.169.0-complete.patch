+//! Opt-in, content-free diagnostics. Never repairs or re-decodes message text.
+use crate::models::{ContentItem, ResponseItem};
+use std::sync::OnceLock;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+pub fn enabled() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var("CODEX_TEXT_INTEGRITY").as_deref() == Ok("1"))
+}
+
+/// Bounded diagnostic volume per process; no body, token, URL, or path is logged.
+pub fn record(
+    stage: &'static str,
+    stream: u64,
+    item: Option<&str>,
+    bytes: u64,
+    replacements: u64,
+    invalid: u64,
+    pending: u64,
+) {
+    static RECORDS: AtomicU64 = AtomicU64::new(0);
+    if !enabled() {
+        return;
+    }
+    let sequence = RECORDS.fetch_add(1, Ordering::Relaxed);
+    if sequence > 8192 {
+        return;
+    }
+    if sequence == 8192 {
+        tracing::warn!(target: "codex_text_integrity", "diagnostic record limit reached; subsequent observations omitted");
+        return;
+    }
+    // Server identifiers are untrusted. Store only a non-content correlation hash.
+    use std::hash::{Hash, Hasher};
+    let item_key = item.map(|id| {
+        let mut h = std::collections::hash_map::DefaultHasher::new();
+        id.hash(&mut h);
+        h.finish()
+    });
+    tracing::warn!(target: "codex_text_integrity", stage, stream, ?item_key, bytes, replacements, invalid, pending, sequence, "text integrity observation");
+}
+
+pub fn text(stage: &'static str, stream: u64, item: Option<&str>, value: &str, always: bool) {
+    if !enabled() {
+        return;
+    }
+    let replacements = value.chars().filter(|c| *c == '\u{fffd}').count() as u64;
+    if always || replacements > 0 {
+        record(stage, stream, item, value.len() as u64, replacements, 0, 0);
+    }
+}
+
+pub fn message(stage: &'static str, stream: u64, value: &ResponseItem) {
+    if !enabled() {
+        return;
+    }
+    if let ResponseItem::Message {
+        id, role, content, ..
+    } = value
+    {
+        if role != "assistant" {
+            return;
+        }
+        let mut bytes = 0;
+        let mut replacements = 0;
+        for part in content {
+            if let ContentItem::OutputText { text, .. } | ContentItem::InputText { text } = part {
+                bytes += text.len() as u64;
+                replacements += text.chars().filter(|c| *c == '\u{fffd}').count() as u64;
+            }
+        }
+        record(
+            stage,
+            stream,
+            id.as_ref().map(|id| id.as_str()),
+            bytes,
+            replacements,
+            0,
+            0,
+        );
+    }
+}
